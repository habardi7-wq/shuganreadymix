# Postgres connection string from your database provider (e.g. Neon).
# Use the "pooled connection" string if your provider offers one.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-value"

# The site's public "chat with us" WhatsApp button (wa.me link), in
# international format with no "+". Defaults to Shugan's real number
# (see lib/site-config.ts) if unset — override per deploy environment here.
# NEXT_PUBLIC_WHATSAPP_NUMBER="966554974814"

# --- OTP delivery: WhatsApp by default ---
# In production, OTP delivery fails closed until a real provider is configured.
# Development/test environments keep the visible console code for local testing.
OTP_DELIVERY_CHANNEL="whatsapp"

# Meta WhatsApp Cloud API. Create and approve an AUTHENTICATION template with a
# copy-code button in WhatsApp Manager. Keep the permanent token server-side.
# META_WHATSAPP_ACCESS_TOKEN=
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_OTP_TEMPLATE="kharasana_pro_otp"
# META_WHATSAPP_TEMPLATE_LANGUAGE="ar"
# META_GRAPH_API_VERSION="v24.0"

# Optional operational fallback. It is disabled unless explicitly set to true.
# OTP_ALLOW_SMS_FALLBACK="false"

# Unifonic (optional SMS mode/fallback for Saudi numbers).
# Sign up at unifonic.com, create an App to get AppSid, and register a
# Sender ID (or use a shared/test one while your own is approved).
# UNIFONIC_APP_SID=
# UNIFONIC_SENDER_ID=

# Twilio (optional SMS mode/fallback, and separate WhatsApp notifications).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM="+1..."
# TWILIO_WHATSAPP_FROM="+1..."

# Resend (used for email notifications).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="Kharasana Pro <notifications@yourdomain.com>"
